# Firebase Web config — ambil dari Firebase Console:
# Project settings > General > Your apps > SDK setup and configuration (Config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=islandgrid-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=islandgrid-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=islandgrid-ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-side saja (JANGAN diberi awalan NEXT_PUBLIC_) ---

# Kredensial admin: dipakai untuk kirim FCM (/api/broadcast) dan scripts/seed.ts.
# Firebase Console > Project settings > Service accounts > Generate new private key
# Lokal: pakai path file. Produksi/VPS: isi FIREBASE_SERVICE_ACCOUNT_JSON (JSON satu baris).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Topic FCM yang di-subscribe aplikasi Android warga (ListrikSiberut).
FCM_TOPIC=WARGA

# Kunci untuk route yang dipanggil cron server (auto-broadcast & verifikasi).
# Buat acak: openssl rand -hex 32
CRON_SECRET=

# Layanan prediksi ML (FastAPI, repo zhhraid/islandgrid-ai-ml).
# Di VPS yang sama: http://127.0.0.1:8080 (port di-bind ke localhost, tidak publik).
# Kosong = tombol "Perbarui Prediksi" nonaktif; dashboard tetap jalan dari Firestore.
ISLANDGRID_API_BASE_URL=
ISLANDGRID_API_KEY=
